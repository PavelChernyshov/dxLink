{
  "name": "@dxfeed/dxlink-deepbook",
  "version": "0.9.0",
  "private": false,
  "sideEffects": false,
  "description": "dxLink DeepBook provides a seamless history-plus-live stream of aggregated price-level orders for order-book heatmaps",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "main": "build/index.js",
  "module": "build/index.mjs",
  "types": "build/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build && pnpm run test",
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --out-dir build",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dxfeed/dxlink-core": "workspace:*",
    "@dxfeed/dxlink-rpc": "workspace:*"
  },
  "peerDependencies": {
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "rxjs": "^7.5.2"
  },
  "author": "Dmitry Petrov <dmitry.petrov@devexperts.com>",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dxfeed/dxlink.git"
  },
  "bugs": {
    "url": "https://github.com/dxfeed/dxlink/issues"
  },
  "homepage": "https://dxfeed.com/",
  "keywords": [
    "api",
    "client",
    "deepbook",
    "order-book",
    "heatmap",
    "price-level",
    "market-data",
    "real-time-data",
    "historical-data",
    "dxfeed",
    "dxlink"
  ],
  "files": [
    "/build",
    "/package.json"
  ]
}
